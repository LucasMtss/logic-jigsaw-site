# Token de acesso do Expo (https://expo.dev/accounts/[conta]/settings/access-tokens).
# Fica só no servidor da Vercel. Nunca exponha este valor no navegador.
EXPO_TOKEN=

# Opcional. O projeto do Logic Jigsaw já é o padrão.
EXPO_PROJECT_ID=d0d70f00-72ec-4885-8bf8-c065bcac9687

# Perfil do eas.json que gera APK. O perfil preview já está com android.buildType = apk.
# O perfil production gera AAB, que não instala direto no celular.
EXPO_BUILD_PROFILE=preview

# Opcional. Se a consulta ao Expo falhar, o site usa esta URL HTTPS.
# APK_DOWNLOAD_URL=https://exemplo.com/logic-jigsaw.apk
